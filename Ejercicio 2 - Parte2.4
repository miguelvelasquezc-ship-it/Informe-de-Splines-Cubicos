#librerias instaladas numpy, matplotlib, scipy, pandas
#en la ventana cmd ejecutar: "pip install numpy" , "pip install matplotlib" , "pip install scipy" , "pip install pandas"
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline


#datos de frecuencia en khz
f = np.array([
    10.0,12.5,15.0,17.5,20.0,22.5,25.0,27.5,30.0,32.5,
    35.0,37.5,40.0,42.5,45.0,47.5,50.0,52.5,55.0,57.5,
    60.0,62.5,65.0,67.5,70.0,72.5,75.0,77.5,80.0,82.5,
    85.0,87.5,90.0,92.5,95.0,97.5,100.0,102.5,105.0,107.5
])

#datos de voltaje
V = np.array([
    0.842,0.911,0.986,1.062,1.143,1.227,1.314,1.401,1.482,1.551,
    1.216,1.048,0.866,0.689,0.521,0.364,0.223,0.103,0.012,-0.041,
    -0.057,-0.034,0.018,0.096,0.197,0.318,0.452,0.579,0.700,0.809,
    0.611,0.688,0.756,0.811,0.856,0.894,0.926,0.954,0.980,1.004
])


#spline cubico

#crea el spline cubico natural a partir de los datos
spline = CubicSpline(f, V, bc_type='natural')


#derivada del spline

#obtiene la derivada analitica del spline
spline_derivada = spline.derivative()


#evaluaciones de la derivada

#evalua la derivada en 40 khz
dV40 = spline_derivada(40.0)

#evalua la derivada en 70 khz
dV70 = spline_derivada(70.0)

#evalua la derivada en 100 khz
dV100 = spline_derivada(100.0)


#tabla de resultados

#organiza los resultados en una tabla
tabla = pd.DataFrame({
    "Frecuencia (kHz)": [40.0, 70.0, 100.0],
    "dV/df spline (V/kHz)": [
        f"{dV40:.6f}",
        f"{dV70:.6f}",
        f"{dV100:.6f}"
    ]
})


#curva derivada

#genera muchos puntos para una curva suave
f_suave = np.linspace(min(f), max(f), 1000)

#evalua la derivada en la malla fina
dV_suave = spline_derivada(f_suave)


#figura con dos graficas

#crea una figura con dos subgraficas verticales
fig, axs = plt.subplots(2, 1, figsize=(9, 8))


#grafica de la derivada

#grafica la curva derivada del spline
axs[0].plot(f_suave, dV_suave)

#marca el punto en 40 khz
axs[0].plot(40.0, dV40, 'o', label='40 kHz')

#marca el punto en 70 khz
axs[0].plot(70.0, dV70, 'o', label='70 kHz')

#marca el punto en 100 khz
axs[0].plot(100.0, dV100, 'o', label='100 kHz')

#titulo de la grafica
axs[0].set_title('Derivada del Spline Cúbico')

#etiqueta del eje horizontal
axs[0].set_xlabel('Frecuencia (kHz)')
#etiqueta del eje vertical
axs[0].set_ylabel('dV/df (V/kHz)')
#activa la cuadricula
axs[0].grid(True)
#muestra la leyenda
axs[0].legend()


#tabla de resultados

#oculta los ejes de la segunda subgrafica
axs[1].axis('off')


#crea la tabla visual
tabla_grafica = axs[1].table(
    cellText=tabla.values,
    colLabels=tabla.columns,
    cellLoc='center',
    loc='center'
)


tabla_grafica.auto_set_font_size(False)
tabla_grafica.set_fontsize(11)
tabla_grafica.scale(1.2, 2)

#titulo de la tabla
axs[1].set_title('Resultados de la Derivación del Spline')



plt.tight_layout()
plt.show()

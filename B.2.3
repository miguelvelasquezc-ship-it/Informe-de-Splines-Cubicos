import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline

# =========================
# DATOS
# =========================

f = np.array([
    100,120,145,170,200,235,270,310,355,405,
    460,520,585,655,730,810,895,985,1080,1180,
    1290,1410,1540,1680,1830,1990,2160,2340,2530,2730
], dtype=float)

Z = np.array([
    152.3,149.1,146.8,144.9,142.0,139.5,137.9,136.1,134.8,133.6,
    132.7,131.9,131.4,131.1,130.9,131.0,131.3,131.9,132.7,133.8,
    135.2,136.9,138.9,141.1,143.5,146.1,149.0,152.2,155.6,159.2
], dtype=float)

# =========================
# POLINOMIO GRADO 10
# =========================

coef = np.polyfit(f, Z, 10)

p = np.poly1d(coef)

# =========================
# SPLINE CÚBICO NATURAL
# =========================

spline = CubicSpline(f, Z, bc_type='natural')

# =========================
# EVALUAR EN 1000 Hz
# =========================

f_interp = 1000

Z_polinomio = p(f_interp)

Z_spline = spline(f_interp)

# =========================
# DATOS PARA TABLA
# =========================

columnas = ["Método", "|Z|(1000 Hz) [ohm]"]

datos = [
    ["Polinomio grado 10", f"{Z_polinomio:.4f}"],
    ["Spline cúbico natural", f"{Z_spline:.4f}"]
]

# =========================
# MOSTRAR TABLA
# =========================

fig, ax = plt.subplots(figsize=(6,2.5))

ax.axis('off')

tabla = ax.table(
    cellText=datos,
    colLabels=columnas,
    loc='center'
)

tabla.auto_set_font_size(False)
tabla.set_fontsize(10)
tabla.scale(1.2, 1.5)

plt.title("Comparación de métodos en 1000 Hz")

plt.show()

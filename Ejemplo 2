#librerias instaladas numpy, matplotlib, scipy
#en la ventana cmd ejecutar: "pip install numpy" , "pip install matplotlib" , "pip install scipy"
import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline

#datos originales

#vector de coordenadas en x
x = np.array([0, 1, 2, 3, 4, 5])
#vector de coordenadas en y
y = np.array([2, 5, 3, 6, 5, 8])


#construccion del spline cubico

#crea el spline cubico natural que interpola los datos
spline = CubicSpline(x, y, bc_type='natural')

#intervalos para cada tramo

#genera puntos para el intervalo entre 0 y 1
x0 = np.linspace(0, 1, 200)
#genera puntos para el intervalo entre 1 y 2
x1 = np.linspace(1, 2, 200)
#genera puntos para el intervalo entre 2 y 3
x2 = np.linspace(2, 3, 200)
#genera puntos para el intervalo entre 3 y 4
x3 = np.linspace(3, 4, 200)
#genera puntos para el intervalo entre 4 y 5
x4 = np.linspace(4, 5, 200)


#grafica principal

#crea la figura de la grafica
plt.figure(figsize=(12,7))

#grafica el primer tramo del spline
plt.plot(
    x0,
    spline(x0),
    color='blue',
    linewidth=2,
    label='S0(x)=2+4.7943x-1.7943x³'
)

#grafica el segundo tramo del spline
plt.plot(
    x1,
    spline(x1),
    color='red',
    linewidth=2,
    label='S1(x)=5-0.5885(x-1)-5.3828(x-1)²+3.9713(x-1)³'
)

#grafica el tercer tramo del spline
plt.plot(
    x2,
    spline(x2),
    color='green',
    linewidth=2,
    label='S2(x)=3+0.5598(x-2)+6.5311(x-2)²-4.0909(x-2)³'
)

#grafica el cuarto tramo del spline
plt.plot(
    x3,
    spline(x3),
    color='orange',
    linewidth=2,
    label='S3(x)=6+1.3493(x-3)-5.7416(x-3)²+3.3923(x-3)³'
)

#grafica el quinto tramo del spline
plt.plot(
    x4,
    spline(x4),
    color='purple',
    linewidth=2,
    label='S4(x)=5+0.0431(x-4)+4.4354(x-4)²-1.4785(x-4)³'
)

#grafica los puntos originales experimentales
plt.scatter(
    x,
    y,
    color='black',
    s=70,
    zorder=5,
    label='Datos originales'
)

#agrega etiquetas a cada punto
for xi, yi in zip(x, y):

    plt.text(
        xi,
        yi + 0.2,
        f'({xi},{yi})',
        fontsize=9
    )


#titulo principal de la grafica
plt.title('Interpolación por Splines Cúbicos')

#etiqueta del eje horizontal
plt.xlabel('x')
#etiqueta del eje vertical
plt.ylabel('y')
#activa la cuadricula
plt.grid(True)
#muestra la leyenda
plt.legend(fontsize=8)

#muestra la grafica final
plt.show()

#librerias instaladas numpy, matplotlib, scipy, pandas
#en la ventana cmd ejecutar: "pip install numpy" , "pip install matplotlib" , "pip install scipy" , "pip install pandas"
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline


#datos de frecuencia en khz
f = np.array([
    10.0,12.5,15.0,17.5,20.0,22.5,25.0,27.5,30.0,32.5,
    35.0,37.5,40.0,42.5,45.0,47.5,50.0,52.5,55.0,57.5,
    60.0,62.5,65.0,67.5,70.0,72.5,75.0,77.5,80.0,82.5,
    85.0,87.5,90.0,92.5,95.0,97.5,100.0,102.5,105.0,107.5
])

#datos de voltaje
V = np.array([
    0.842,0.911,0.986,1.062,1.143,1.227,1.314,1.401,1.482,1.551,
    1.216,1.048,0.866,0.689,0.521,0.364,0.223,0.103,0.012,-0.041,
    -0.057,-0.034,0.018,0.096,0.197,0.318,0.452,0.579,0.700,0.809,
    0.611,0.688,0.756,0.811,0.856,0.894,0.926,0.954,0.980,1.004
])

#datos de impedancia en ohmios
Z = np.array([
    182.4,178.9,175.1,171.0,166.8,162.7,158.9,155.4,152.0,149.0,
    146.1,145.2,145.8,147.3,149.9,153.5,158.0,163.2,168.9,174.8,
    180.5,186.2,191.5,196.2,200.1,203.1,205.2,206.3,206.1,204.7,
    198.0,194.4,190.9,187.8,185.1,183.0,181.6,180.8,180.6,180.9
])


#spline cubico natural

#crea el spline para los datos de voltaje
spline_V = CubicSpline(f, V, bc_type='natural')

#crea el spline para los datos de impedancia
spline_Z = CubicSpline(f, Z, bc_type='natural')


#evaluaciones en frecuencias especificas

#evalua el voltaje en 41 khz
V_41 = spline_V(41.0)

#evalua la impedancia en 41 khz
Z_41 = spline_Z(41.0)

#evalua el voltaje en 73 khz
V_73 = spline_V(73.0)

#evalua la impedancia en 73 khz
Z_73 = spline_Z(73.0)


#tabla de resultados

#crea una tabla con los valores interpolados
tabla = pd.DataFrame({
    "Magnitud": [
        "V(41.0 kHz)",
        "|Z|(41.0 kHz)",
        "V(73.0 kHz)",
        "|Z|(73.0 kHz)"
    ],
    "Valor Aproximado": [
        f"{V_41:.4f} V",
        f"{Z_41:.4f} Ω",
        f"{V_73:.4f} V",
        f"{Z_73:.4f} Ω"
    ]
})


#puntos suaves para graficar los splines

#genera una malla fina de frecuencias
f_suave = np.linspace(min(f), max(f), 1000)

#evalua el spline de voltaje
V_suave = spline_V(f_suave)

#evalua el spline de impedancia
Z_suave = spline_Z(f_suave)


#figura con tres graficos

#crea una figura con tres subgraficas verticales
fig, axs = plt.subplots(3, 1, figsize=(10, 12))


#grafica de v(f)

#grafica los datos originales de voltaje
axs[0].plot(
    f,
    V,
    'o',
    label='Datos experimentales'
)

#grafica el spline cubico del voltaje
axs[0].plot(
    f_suave,
    V_suave,
    label='Spline cúbico natural'
)

#titulo de la grafica
axs[0].set_title('Spline Cúbico Natural para V(f)')
#etiqueta del eje horizontal
axs[0].set_xlabel('Frecuencia (kHz)')
#etiqueta del eje vertical
axs[0].set_ylabel('Voltaje V(f)')
#activa la cuadricula
axs[0].grid(True)
#muestra la leyenda
axs[0].legend()


#grafica de |z|(f)

#grafica los datos originales de impedancia
axs[1].plot(
    f,
    Z,
    'o',
    label='Datos experimentales'
)

#grafica el spline cubico de impedancia
axs[1].plot(
    f_suave,
    Z_suave,
    label='Spline cúbico natural'
)

#titulo de la grafica
axs[1].set_title('Spline Cúbico Natural para |Z|(f)')
#etiqueta del eje horizontal
axs[1].set_xlabel('Frecuencia (kHz)')
#etiqueta del eje vertical
axs[1].set_ylabel('|Z|(Ω)')
#activa la cuadricula
axs[1].grid(True)
#muestra la leyenda
axs[1].legend()


#tabla de resultados

#oculta los ejes de la tercera subgrafica
axs[2].axis('off')


#crea la tabla visual
tabla_grafica = axs[2].table(
    cellText=tabla.values,
    colLabels=tabla.columns,
    cellLoc='center',
    loc='center'
)

#desactiva el tamaño automatico de fuente
tabla_grafica.auto_set_font_size(False)

#establece el tamaño de letra
tabla_grafica.set_fontsize(11)

#ajusta el tamaño de las celdas
tabla_grafica.scale(1.2, 2)

#titulo de la tabla
axs[2].set_title('Resultados Evaluados con Spline Cúbico')


plt.tight_layout()
plt.show()

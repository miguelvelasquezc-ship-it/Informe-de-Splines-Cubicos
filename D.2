import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline

# =========================
# DATOS
# =========================

f = np.array([
    100,120,145,170,200,235,270,310,355,405,
    460,520,585,655,730,810,895,985,1080,1180,
    1290,1410,1540,1680,1830,1990,2160,2340,2530,2730
], dtype=float)

Z = np.array([
    152.3,149.1,146.8,144.9,142.0,139.5,137.9,136.1,134.8,133.6,
    132.7,131.9,131.4,131.1,130.9,131.0,131.3,131.9,132.7,133.8,
    135.2,136.9,138.9,141.1,143.5,146.1,149.0,152.2,155.6,159.2
], dtype=float)

# =========================
# SPLINE CÚBICO
# =========================

spline = CubicSpline(f, Z, bc_type='natural')

# Función:
# g(f) = |Z|(f) - 150

Z_th = 150

def g(x):
    return spline(x) - Z_th

# Derivada para Newton
g_der = spline.derivative()

# ==================================================
# MÉTODO DE BISECCIÓN
# ==================================================

a = 100
b = 200

tol = 1e-6
max_iter = 100

for i in range(max_iter):

    c = (a + b) / 2

    if abs(g(c)) < tol:
        break

    if g(a) * g(c) < 0:
        b = c
    else:
        a = c

raiz_biseccion = c

# ==================================================
# MÉTODO DE NEWTON-RAPHSON
# ==================================================

x0 = 130   # aproximación inicial cercana

for i in range(max_iter):

    x1 = x0 - g(x0)/g_der(x0)

    if abs(x1 - x0) < tol:
        break

    x0 = x1

raiz_newton = x1

# =========================
# GRÁFICA
# =========================

x = np.linspace(min(f), max(f), 2000)

y = spline(x)

plt.figure(figsize=(10,6))

plt.plot(x, y,
         linewidth=2,
         label='Spline cúbico')

plt.axhline(Z_th,
            color='black',
            linestyle='--',
            label='Z_th = 150 ohm')

# Raíces
plt.scatter(raiz_biseccion, Z_th,
            color='red',
            s=80,
            label='Bisección')

plt.scatter(raiz_newton, Z_th,
            color='green',
            s=80,
            label='Newton-Raphson')

# Texto
plt.text(
    0.02, 0.92,
    f'Bisección = {raiz_biseccion:.6f} Hz\n'
    f'Newton = {raiz_newton:.6f} Hz',
    transform=plt.gca().transAxes,
    fontsize=10,
    bbox=dict(facecolor='white', alpha=0.8)
)

plt.xlabel('Frecuencia (Hz)')
plt.ylabel('|Z| (ohm)')

plt.title('Comparación de métodos de búsqueda de raíces')

plt.grid(True)
plt.legend()

plt.show()

# =========================
# RESULTADOS
# =========================

print(f"Raíz por bisección = {raiz_biseccion:.6f} Hz")

print(f"Raíz por Newton-Raphson = {raiz_newton:.6f} Hz")

#librerias instaladas numpy, matplotlib, scipy, pandas
#en la ventana cmd ejecutar: "pip install numpy" , "pip install matplotlib" , "pip install scipy" , "pip install pandas"
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline

#datos de frecuencia en khz
f = np.array([
    10.0,12.5,15.0,17.5,20.0,22.5,25.0,27.5,30.0,32.5,
    35.0,37.5,40.0,42.5,45.0,47.5,50.0,52.5,55.0,57.5,
    60.0,62.5,65.0,67.5,70.0,72.5,75.0,77.5,80.0,82.5,
    85.0,87.5,90.0,92.5,95.0,97.5,100.0,102.5,105.0,107.5
])

#datos de voltaje
V = np.array([
    0.842,0.911,0.986,1.062,1.143,1.227,1.314,1.401,1.482,1.551,
    1.216,1.048,0.866,0.689,0.521,0.364,0.223,0.103,0.012,-0.041,
    -0.057,-0.034,0.018,0.096,0.197,0.318,0.452,0.579,0.700,0.809,
    0.611,0.688,0.756,0.811,0.856,0.894,0.926,0.954,0.980,1.004
])

#spline cubico natural

spline = CubicSpline(f, V, bc_type='natural')

#curva suave

f_suave = np.linspace(10, 107.5, 20000)

V_suave = spline(f_suave)

#busqueda de cambio de signo

raices = []

for i in range(len(V_suave)-1):

    if V_suave[i] * V_suave[i+1] < 0:

        raiz = (f_suave[i] + f_suave[i+1]) / 2
        raices.append(raiz)

#tabla

tabla = pd.DataFrame({
    "Raíz": ["Primera raíz", "Segunda raíz"],
    "Frecuencia aproximada (kHz)": [
        f"{raices[0]:.6f}",
        f"{raices[1]:.6f}"
    ]
})


fig, axs = plt.subplots(2, 1, figsize=(10, 9))

#grafica

axs[0].plot(f_suave, V_suave, label='Spline cúbico V(f)')

axs[0].axhline(0, linestyle='--')

#primera raiz
axs[0].plot(
    raices[0],
    spline(raices[0]),
    'o',
    markersize=8,
    label=f'Primera raíz ≈ {raices[0]:.6f} kHz'
)

#segunda raiz
axs[0].plot(
    raices[1],
    spline(raices[1]),
    'x',
    markersize=10,
    label=f'Segunda raíz ≈ {raices[1]:.6f} kHz'
)

axs[0].set_title('Raíces obtenidas mediante Spline Cúbico')
axs[0].set_xlabel('Frecuencia (kHz)')
axs[0].set_ylabel('Voltaje V(f)')
axs[0].grid(True)
axs[0].legend()


axs[1].axis('off')

tabla_grafica = axs[1].table(
    cellText=tabla.values,
    colLabels=tabla.columns,
    cellLoc='center',
    loc='center'
)

tabla_grafica.auto_set_font_size(False)
tabla_grafica.set_fontsize(11)
tabla_grafica.scale(1.2, 2)

axs[1].set_title('Raíces Aproximadas mediante Spline')


plt.tight_layout()
plt.show()

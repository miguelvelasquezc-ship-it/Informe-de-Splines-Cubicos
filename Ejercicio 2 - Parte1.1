#funcion de lagrange de segundo grado

#calcula el polinomio interpolador de lagrange
def lagrange_segundo_grado(x, x_datos, y_datos):

    #cantidad de puntos
    n = len(x_datos)

    #variable acumuladora del resultado
    resultado = 0

    #recorre cada termino del polinomio
    for i in range(n):

        #inicializa el termino correspondiente
        termino = y_datos[i]

        #calcula el producto de lagrange
        for j in range(n):

            #evita dividir entre cero
            if i != j:

                termino *= (x - x_datos[j]) / (x_datos[i] - x_datos[j])

        #suma el termino al resultado final
        resultado += termino

    return resultado



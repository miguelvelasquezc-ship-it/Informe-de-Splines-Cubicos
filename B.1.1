#librerias instaladas numpy, matplotlib
#en la ventana cmd ejecutar: "pip install numpy" , "pip install matplotlib"
import numpy as np
import matplotlib.pyplot as plt


#frecuencias experimentales en hz
f = np.array([
    100,120,145,170,200,235,270,310,355,405,
    460,520,585,655,730,810,895,985,1080,1180,
    1290,1410,1540,1680,1830,1990,2160,2340,2530,2730
], dtype=float)

#impedancias medidas en ohmios
Z = np.array([
    152.3,149.1,146.8,144.9,142.0,139.5,137.9,136.1,134.8,133.6,
    132.7,131.9,131.4,131.1,130.9,131.0,131.3,131.9,132.7,133.8,
    135.2,136.9,138.9,141.1,143.5,146.1,149.0,152.2,155.6,159.2
], dtype=float)


#metodo matricial

#calcula los coeficientes del polinomio grado 10
coef = np.polyfit(f, Z, 10)

#crea la funcion polinomica del metodo matricial
p_matricial = np.poly1d(coef)

#metodo de lagrange

#selecciona 11 puntos para construir el polinomio de lagrange
indices = [0, 3, 6, 9, 12, 15, 18, 21, 24, 27, 29]

#frecuencias seleccionadas
f_lag = f[indices]

#impedancias seleccionadas
Z_lag = Z[indices]

#funcion que calcula el polinomio de lagrange
def lagrange(x_eval, x, y):

    #numero de puntos
    n = len(x)

    #variable acumuladora del resultado
    resultado = 0

    #recorre cada termino del polinomio
    for i in range(n):

        #inicializa el polinomio base de lagrange
        Li = 1

        #calcula el producto correspondiente
        for j in range(n):

            #evita dividir entre cero
            if i != j:

                Li *= (x_eval - x[j]) / (x[i] - x[j])

        #suma el termino correspondiente
        resultado += y[i] * Li

    return resultado

#malla fina para visualizar las curvas

#genera muchos puntos para obtener curvas suaves
x = np.linspace(min(f), max(f), 3000)

#evaluacion del metodo matricial

#evalua el polinomio matricial en la malla
y_matricial = p_matricial(x)

#evaluacion del metodo de lagrange

#evalua el polinomio de lagrange punto por punto
y_lagrange = np.array([
    lagrange(xi, f_lag, Z_lag)
    for xi in x
])


#grafica principal

#crea la figura de la grafica
plt.figure(figsize=(12,7))

#grafica los datos experimentales originales
plt.scatter(
    f,
    Z,
    color='black',
    label='Datos experimentales',
    zorder=5
)

#grafica la curva del metodo matricial
plt.plot(
    x,
    y_matricial,
    linewidth=2,
    label='Método matricial (grado 10)'
)

#grafica la curva del metodo de lagrange
plt.plot(
    x,
    y_lagrange,
    linewidth=2,
    linestyle='--',
    label='Lagrange (grado 10)'
)

#grafica los puntos utilizados en lagrange
plt.scatter(
    f_lag,
    Z_lag,
    color='red',
    s=70,
    label='Puntos usados en Lagrange'
)


#etiqueta del eje horizontal
plt.xlabel('Frecuencia (Hz)')
#etiqueta del eje vertical
plt.ylabel('|Z| (ohm)')
#titulo principal de la grafica
plt.title('Comparación: Método Matricial vs Lagrange')

#activa la cuadricula
plt.grid(True)
#muestra la leyenda
plt.legend()

plt.ylim(
    min(y_matricial) - 5,
    max(y_matricial) + 5
)

#muestra la grafica final
plt.show()

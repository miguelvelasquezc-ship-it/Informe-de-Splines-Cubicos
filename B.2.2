#librerias instaladas numpy, matplotlib, scipy
#en la ventana cmd ejecutar: "pip install numpy" , "pip install matplotlib" , "pip install scipy"
import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline


#frecuencias experimentales en hz
f = np.array([
    100,120,145,170,200,235,270,310,355,405,
    460,520,585,655,730,810,895,985,1080,1180,
    1290,1410,1540,1680,1830,1990,2160,2340,2530,2730
], dtype=float)

#impedancias medidas en ohmios
Z = np.array([
    152.3,149.1,146.8,144.9,142.0,139.5,137.9,136.1,134.8,133.6,
    132.7,131.9,131.4,131.1,130.9,131.0,131.3,131.9,132.7,133.8,
    135.2,136.9,138.9,141.1,143.5,146.1,149.0,152.2,155.6,159.2
], dtype=float)


#polinomio grado 10

#define el grado del polinomio
grado = 10

#calcula los coeficientes del polinomio mediante ajuste matricial
coef = np.polyfit(f, Z, grado)

#crea la funcion polinomica usando los coeficientes obtenidos
p = np.poly1d(coef)

#spline cubico natural

#crea el spline cubico con condiciones naturales en los extremos
spline = CubicSpline(f, Z, bc_type='natural')

#malla fina para visualizar ambas curvas

#genera muchos puntos para obtener curvas suaves
x = np.linspace(min(f), max(f), 2000)

#evalua el polinomio en la malla
y_polinomio = p(x)
#evalua el spline en la malla
y_spline = spline(x)

#interpolacion en 1000 hz

#frecuencia donde se desea interpolar
f_interp = 1000
#calcula el valor interpolado con el polinomio
Z_polinomio = p(f_interp)
#calcula el valor interpolado con el spline cubico
Z_spline = spline(f_interp)


#grafica comparativa

#crea la figura principal
plt.figure(figsize=(10,6))

#grafica los datos experimentales originales
plt.scatter(
    f,
    Z,
    color='red',
    label='Datos experimentales'
)

#grafica la curva del polinomio grado 10
plt.plot(
    x,
    y_polinomio,
    linewidth=2,
    label='Polinomio grado 10'
)

#grafica la curva del spline cubico
plt.plot(
    x,
    y_spline,
    linewidth=2,
    linestyle='--',
    label='Spline cúbico natural'
)


#etiqueta del eje horizontal
plt.xlabel('Frecuencia (Hz)')
#etiqueta del eje vertical
plt.ylabel('|Z| (ohm)')
#titulo principal de la grafica
plt.title('Comparación: Polinomio vs Spline Cúbico')


#activa la cuadricula
plt.grid(True)
#muestra la leyenda
plt.legend()
#muestra la grafica final
plt.show()


#imprime el valor interpolado usando polinomio
print(f"Valor con polinomio grado 10 en 1000 Hz = {Z_polinomio:.4f} ohm")
#imprime el valor interpolado usando spline cubico
print(f"Valor con spline cúbico en 1000 Hz = {Z_spline:.4f} ohm")

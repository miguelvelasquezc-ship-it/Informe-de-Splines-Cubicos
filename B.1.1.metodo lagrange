#Librerias instaladas numpy, matplotlib
#En la ventana CMD ejecutar: "pip install numpy" , "pip install matplotlib"
import numpy as np
import matplotlib.pyplot as plt

#frecuencias experimentales
f_total = np.array([
    100,120,145,170,200,235,270,310,355,405,
    460,520,585,655,730,810,895,985,1080,1180,
    1290,1410,1540,1680,1830,1990,2160,2340,2530,2730
], dtype=float)

#impedancias experimentales
Z_total = np.array([
    152.3,149.1,146.8,144.9,142.0,139.5,137.9,136.1,134.8,133.6,
    132.7,131.9,131.4,131.1,130.9,131.0,131.3,131.9,132.7,133.8,
    135.2,136.9,138.9,141.1,143.5,146.1,149.0,152.2,155.6,159.2
], dtype=float)

#selecciona algunos indices para construir el polinomio de grado 10
indices = [0,3,6,9,12,15,18,21,24,27,29]
#extrae las frecuencias seleccionadas
f = f_total[indices]
#extrae las impedancias seleccionadas
Z = Z_total[indices]

#funcion que calcula la interpolacion de lagrange
def lagrange(x_eval, x, y):
    #numero de puntos utilizados
    n = len(x)
    #variable acumuladora del polinomio
    p = 0
    #recorre cada termino del polinomio
    for i in range(n):
        #inicializa el polinomio base de lagrange
        Li = 1
        #calcula el producto del polinomio base
        for j in range(n):

            #evita division entre cero
            if i != j:
                Li *= (x_eval - x[j]) / (x[i] - x[j])
        #acumula el termino correspondiente
        p += y[i] * Li
    #retorna el valor interpolado
    return p

#genera puntos para dibujar la curva interpolada
x = np.linspace(min(f_total), max(f_total), 1000)
#calcula la interpolacion en cada punto generado
y_interp = np.array([
    lagrange(xi, f, Z) for xi in x
])

#crea la figura de la grafica
plt.figure(figsize=(10,6))

#grafica los datos experimentales originales
plt.scatter(
    f_total,
    Z_total,
    color='red',
    label='Datos experimentales'
)

#grafica la curva interpolada de lagrange
plt.plot(
    x,
    y_interp,
    linewidth=2,
    label='Lagrange grado 10'
)

#etiqueta del eje horizontal
plt.xlabel('Frecuencia (Hz)')
#etiqueta del eje vertical
plt.ylabel('|Z| (ohm)')
#titulo de la grafica
plt.title('Interpolación de Lagrange - Grado 10')
#activa la cuadricula
plt.grid(True)

#muestra la leyenda
plt.legend()

#muestra la grafica
plt.show()


#frecuencia interpolada
f_interp = 1500
valor = lagrange(f_interp, f, Z)
print(f"Valor interpolado en {f_interp} Hz = {valor:.4f} ohm")

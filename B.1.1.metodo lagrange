import numpy as np
import matplotlib.pyplot as plt

# DATOS
f_total = np.array([
    100,120,145,170,200,235,270,310,355,405,
    460,520,585,655,730,810,895,985,1080,1180,
    1290,1410,1540,1680,1830,1990,2160,2340,2530,2730
], dtype=float)

Z_total = np.array([
    152.3,149.1,146.8,144.9,142.0,139.5,137.9,136.1,134.8,133.6,
    132.7,131.9,131.4,131.1,130.9,131.0,131.3,131.9,132.7,133.8,
    135.2,136.9,138.9,141.1,143.5,146.1,149.0,152.2,155.6,159.2
], dtype=float)

# SELECCIONAR 11 PUNTOS PARA GRADO 10
indices = [0,3,6,9,12,15,18,21,24,27,29]

f = f_total[indices]
Z = Z_total[indices]

# FUNCIÓN DE LAGRANGE
def lagrange(x_eval, x, y):

    n = len(x)
    p = 0

    for i in range(n):

        Li = 1

        for j in range(n):

            if i != j:
                Li *= (x_eval - x[j]) / (x[i] - x[j])

        p += y[i] * Li

    return p

# EVALUACIÓN
x = np.linspace(min(f_total), max(f_total), 1000)

y_interp = np.array([
    lagrange(xi, f, Z) for xi in x
])

# GRÁFICA
plt.figure(figsize=(10,6))

plt.scatter(f_total, Z_total,
            color='red',
            label='Datos experimentales')

plt.plot(x, y_interp,
         linewidth=2,
         label='Lagrange grado 10')

plt.xlabel('Frecuencia (Hz)')
plt.ylabel('|Z| (ohm)')
plt.title('Interpolación de Lagrange - Grado 10')

plt.grid(True)
plt.legend()

plt.show()

# INTERPOLACIÓN
f_interp = 1500

valor = lagrange(f_interp, f, Z)

print(f"Valor interpolado en {f_interp} Hz = {valor:.4f} ohm")

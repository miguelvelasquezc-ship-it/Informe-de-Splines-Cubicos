#librerias instaladas numpy, matplotlib, scipy
#en la ventana cmd ejecutar: "pip install numpy" , "pip install matplotlib" , "pip install scipy"
import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline


#frecuencias experimentales en hz
f = np.array([
    100,120,145,170,200,235,270,310,355,405,
    460,520,585,655,730,810,895,985,1080,1180,
    1290,1410,1540,1680,1830,1990,2160,2340,2530,2730
], dtype=float)

#impedancias medidas en ohmios
Z = np.array([
    152.3,149.1,146.8,144.9,142.0,139.5,137.9,136.1,134.8,133.6,
    132.7,131.9,131.4,131.1,130.9,131.0,131.3,131.9,132.7,133.8,
    135.2,136.9,138.9,141.1,143.5,146.1,149.0,152.2,155.6,159.2
], dtype=float)

#spline cubico natural

#crea el spline cubico usando condiciones naturales
spline = CubicSpline(f, Z, bc_type='natural')

#primera derivada

#obtiene la primera derivada del spline
spline_derivada = spline.derivative()

#evalua la derivada en los puntos originales
dZ_df = spline_derivada(f)

#malla fina para visualizar la derivada

#genera una malla fina para obtener una curva suave
x = np.linspace(min(f), max(f), 2000)

#evalua la derivada del spline en la malla
y_derivada = spline_derivada(x)

#ubicacion precisa del minimo

#calcula las raices de la primera derivada
raices = spline_derivada.roots()

#selecciona solo las raices dentro del intervalo experimental
raices_validas = raices[
    (raices >= min(f)) & (raices <= max(f))
]

#obtiene la frecuencia donde ocurre el minimo
f_min = raices_validas[0]

#calcula el valor minimo de impedancia
Z_min = spline(f_min)

#segunda derivada

#obtiene la segunda derivada del spline
spline_segunda = spline.derivative(2)

#evalua la segunda derivada en el minimo
segunda_derivada = spline_segunda(f_min)

#grafica de la derivada

#crea la figura principal
plt.figure(figsize=(10,6))

#grafica la curva de la primera derivada
plt.plot(
    x,
    y_derivada,
    linewidth=2,
    label=r'$\frac{d|Z|}{df}$'
)

#dibuja una linea horizontal en cero
plt.axhline(
    0,
    color='black',
    linestyle='--'
)

#dibuja una linea vertical en la frecuencia minima
plt.axvline(
    f_min,
    color='red',
    linestyle='--',
    label=f'Mínimo ≈ {f_min:.4f} Hz'
)

#grafica los valores de la derivada en los puntos experimentales
plt.scatter(
    f,
    dZ_df,
    color='red',
    zorder=3,
    label='Derivada en datos'
)

#agrega informacion adicional dentro de la grafica
plt.text(
    0.02,
    0.92,
    f'Mínimo ≈ {f_min:.4f} Hz\n'
    f'|Z|min ≈ {Z_min:.4f} ohm\n'
    f'd²|Z|/df² ≈ {segunda_derivada:.8f}',
    transform=plt.gca().transAxes,
    fontsize=10,
    bbox=dict(facecolor='white', alpha=0.8)
)

#etiqueta del eje horizontal
plt.xlabel('Frecuencia (Hz)')
#etiqueta del eje vertical
plt.ylabel(r'$\frac{d|Z|}{df}$')
#titulo principal de la grafica
plt.title('Derivada del Spline Cúbico Natural')

#activa la cuadricula
plt.grid(True)
#muestra la leyenda
plt.legend()
#muestra la grafica final
plt.show()


#imprime la frecuencia donde ocurre el minimo
print(f"Frecuencia del mínimo = {f_min:.4f} Hz")
#imprime el valor minimo de impedancia
print(f"Valor mínimo de |Z| = {Z_min:.4f} ohm")
#imprime el valor de la segunda derivada en el minimo
print(f"Segunda derivada en el mínimo = {segunda_derivada:.8f}")

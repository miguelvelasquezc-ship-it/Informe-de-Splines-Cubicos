import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline

# =========================
# DATOS
# =========================

f = np.array([
    100,120,145,170,200,235,270,310,355,405,
    460,520,585,655,730,810,895,985,1080,1180,
    1290,1410,1540,1680,1830,1990,2160,2340,2530,2730
], dtype=float)

Z = np.array([
    152.3,149.1,146.8,144.9,142.0,139.5,137.9,136.1,134.8,133.6,
    132.7,131.9,131.4,131.1,130.9,131.0,131.3,131.9,132.7,133.8,
    135.2,136.9,138.9,141.1,143.5,146.1,149.0,152.2,155.6,159.2
], dtype=float)

# =========================
# SPLINE CÚBICO
# =========================

spline = CubicSpline(f, Z, bc_type='natural')

# Umbral
Z_th = 150

# =========================
# FUNCIÓN
# =========================

def g(x):
    return spline(x) - Z_th

# Derivada
g_der = spline.derivative()

# =========================
# NEWTON-RAPHSON
# RAÍZ CERCA DE 2000 Hz
# =========================

x0 = 2200

tol = 1e-8
max_iter = 100

for i in range(max_iter):

    x1 = x0 - g(x0)/g_der(x0)

    if abs(x1 - x0) < tol:
        break

    x0 = x1

raiz = x1

# =========================
# SENSIBILIDAD
# df/d|Z|
# =========================

# d|Z|/df
dZ_df = g_der(raiz)

# Derivada inversa
df_dZ = 1 / dZ_df

# =========================
# GRÁFICA
# =========================

x = np.linspace(min(f), max(f), 2000)

y = spline(x)

plt.figure(figsize=(10,6))

plt.plot(x, y,
         linewidth=2,
         label='Spline cúbico')

plt.axhline(Z_th,
            color='black',
            linestyle='--',
            label='Z_th = 150 ohm')

plt.scatter(raiz, Z_th,
            color='red',
            s=80,
            zorder=5,
            label='Raíz cercana a 2000 Hz')

# Texto
plt.text(
    0.02, 0.92,
    f'Raíz ≈ {raiz:.6f} Hz\n'
    f'd|Z|/df ≈ {dZ_df:.8f}\n'
    f'df/d|Z| ≈ {df_dZ:.8f}',
    transform=plt.gca().transAxes,
    fontsize=10,
    bbox=dict(facecolor='white', alpha=0.8)
)

plt.xlabel('Frecuencia (Hz)')
plt.ylabel('|Z| (ohm)')

plt.title('Sensibilidad de la raíz')

plt.grid(True)
plt.legend()

plt.show()

# =========================
# RESULTADOS
# =========================

print(f"Raíz cercana a 2000 Hz = {raiz:.6f} Hz")

print(f"d|Z|/df = {dZ_df:.8f}")

print(f"df/d|Z| = {df_dZ:.8f}")
